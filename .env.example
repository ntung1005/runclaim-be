# Lấy các giá trị bằng: npx supabase status -o env
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

PORT=8787
# Bật API giả lập /dev/* (đối thủ demo, runner xin vào CLB). Không bật trên production.
ENABLE_DEV_TOOLS=true
# Origin được gọi API từ trình duyệt. * khi phát triển.
CORS_ORIGIN=*
# Số lần đăng nhập / đăng ký mỗi 5 phút cho một IP. Để cao khi chạy e2e nhiều lần.
AUTH_MAX_ATTEMPTS=10
# Thông báo đẩy: đường dẫn tới file JSON service account Firebase (Project settings >
# Service accounts > Generate new private key). Để trống thì không gửi thông báo.
FCM_SERVICE_ACCOUNT=
